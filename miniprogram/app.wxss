/**app.wxss**/
page {
  background: #f5f7fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1f2733;
  font-size: 30rpx;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: 30rpx;
  color: inherit;
}

button::after {
  border: none;
}

/* 通用按钮 */
.btn-primary {
  background: #4b6ef5;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(75, 110, 245, 0.25);
}

.btn-primary.btn-disabled {
  background: #b9c6f8;
  box-shadow: none;
}

.btn-ghost {
  background: #fff;
  color: #4b6ef5;
  border: 2rpx solid #4b6ef5;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-plain {
  background: #eef1f7;
  color: #5a6474;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-warn {
  background: #f04438;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  text-align: center;
}
