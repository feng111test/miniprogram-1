.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.body {
  flex: 1;
  padding: 24rpx;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 39, 51, 0.05);
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2733;
  margin-bottom: 16rpx;
}

.label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.counter {
  font-size: 24rpx;
  color: #a4abb8;
}

.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.switch-info {
  flex: 1;
  padding-right: 20rpx;
}

.switch-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2733;
}

.switch-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a93a5;
  line-height: 1.5;
}

.input {
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  height: 420rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.tools {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tool {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  background: #eef1f7;
  color: #5a6474;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.result-stat {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #4b6ef5;
}

.stat-label {
  font-size: 22rpx;
  color: #8a93a5;
  margin-top: 6rpx;
}

.preview {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.preview-title {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.6;
}

.preview-type {
  flex-shrink: 0;
  margin-right: 12rpx;
  margin-top: 4rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #e8efff;
  color: #4b6ef5;
}

.preview-text {
  flex: 1;
}

.preview-answer {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #16b364;
}

.errors {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fef3f2;
  border-radius: 16rpx;
}

.errors-title {
  font-size: 26rpx;
  color: #f04438;
  margin-bottom: 10rpx;
}

.error-item {
  font-size: 24rpx;
  color: #912018;
  line-height: 1.6;
}

.no-result {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a93a5;
}

.help-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
}

.arrow {
  font-size: 26rpx;
  color: #4b6ef5;
  font-weight: 400;
}

.help {
  margin-top: 20rpx;
}

.help-title {
  font-size: 26rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.code {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4a5468;
  white-space: pre-wrap;
  word-break: break-all;
}

.help-tips {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a93a5;
  line-height: 1.8;
}

.pad {
  height: 40rpx;
}

.footer {
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(31, 39, 51, 0.05);
}
