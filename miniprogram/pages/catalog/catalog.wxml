<view class="page">
  <view class="intro">
    <view class="intro-title">2026 高考化学真题</view>
    <view class="intro-desc">可以添加全国混合题库连续刷题，也可以单独添加各地区试卷。添加后可在刷题页校对并保存到自己的题库。</view>
  </view>
  <view wx:if="{{loading}}" class="state">正在读取题库目录…</view>
  <view wx:if="{{error}}" class="state error" bindtap="refresh">{{error}}，点此重试</view>
  <view wx:for="{{banks}}" wx:key="id" class="card">
    <view class="card-copy">
      <view class="name">{{item.name}}</view>
      <view class="desc">{{item.desc}}</view>
    </view>
    <button class="add {{item.added ? 'added' : ''}}" data-index="{{index}}" bindtap="onAdd" disabled="{{item.added}}">{{item.added ? '已添加' : '添加'}}</button>
  </view>
</view>
