.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 只有题目列表区域可伸缩滚动，其余区块禁止被压缩，
   否则 button 内容会被裁掉，只露出上半部分 */
.header,
.stat-row,
.share-card,
.filter,
.footer {
  flex-shrink: 0;
}

.header {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #4b6ef5, #6d8bff);
  color: #fff;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.score-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-num {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1;
}

.score-unit {
  font-size: 26rpx;
  margin-left: 2rpx;
}

.score-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

.header-info {
  margin-left: 32rpx;
  flex: 1;
}

.header-bank {
  font-size: 34rpx;
  font-weight: 600;
}

.header-mode {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.stat-row {
  display: flex;
  flex-direction: row;
  background: #fff;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.stat-box {
  flex: 1;
  text-align: center;
}

.stat-box-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2733;
}

.stat-box-num.ok {
  color: #16b364;
}

.stat-box-num.bad {
  color: #f04438;
}

.stat-box-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a93a5;
}

.share-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  /* 覆盖 button 的默认高度，改为由内容撑开 */
  height: auto;
  background: linear-gradient(135deg, #4b6ef5, #6d8bff);
  border-radius: 20rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.share-card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.filter {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx 20rpx;
}

.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5a6474;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.filter-item.on {
  background: #4b6ef5;
  color: #fff;
}

.body {
  flex: 1;
  /* min-height:0 是 flex 子项滚动区域的必要声明，
     否则内容撑开时无法正确收缩 */
  min-height: 0;
  padding: 0 24rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 39, 51, 0.05);
}

.item-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.item-no {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef1f7;
  color: #5a6474;
  font-size: 26rpx;
}

.item-no.ok {
  background: #16b364;
  color: #fff;
}

.item-no.bad {
  background: #f04438;
  color: #fff;
}

.item-type {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a93a5;
}

.item-status {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 600;
}

.item-status.ok {
  color: #16b364;
}

.item-status.bad {
  color: #f04438;
}

.item-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.7;
}

.item-line {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.opt-key {
  min-width: 44rpx;
  padding: 4rpx 12rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #f1f3f8;
  color: #5a6474;
  font-size: 24rpx;
  flex-shrink: 0;
}

.opt-key.right {
  background: #16b364;
  color: #fff;
}

.opt-key.wrong {
  background: #f04438;
  color: #fff;
}

.opt-key.checked {
  background: #4b6ef5;
  color: #fff;
}

.opt-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4a5468;
}

.item-answer {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #5a6474;
  line-height: 1.6;
}

.item-analysis {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a5468;
  white-space: pre-wrap;
}

.analysis-label {
  color: #4b6ef5;
  font-weight: 600;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #a4abb8;
  font-size: 28rpx;
}

.pad {
  height: 40rpx;
}

.footer {
  display: flex;
  flex-direction: row;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(31, 39, 51, 0.05);
}

.footer button {
  flex: 1;
  margin-left: 16rpx;
}

.footer button:first-child {
  margin-left: 0;
}
