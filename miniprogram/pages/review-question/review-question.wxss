.page { min-height: 100vh; padding: 24rpx; padding-bottom: 60rpx; box-sizing: border-box; background: #f5f7fa; }
.hint { padding: 22rpx 28rpx; color: #667085; font-size: 24rpx; line-height: 1.6; }
.section { background: #fff; border-radius: 18rpx; padding: 26rpx; margin-bottom: 18rpx; }
.label { margin-bottom: 16rpx; color: #344054; font-size: 26rpx; font-weight: 600; }
.field { width: 100%; min-height: 72rpx; padding: 18rpx; box-sizing: border-box; border-radius: 12rpx; background: #f8fafc; color: #202939; font-size: 28rpx; line-height: 1.6; }
.large { min-height: 180rpx; }
.option { display: flex; flex-direction: row; align-items: flex-start; gap: 14rpx; margin-bottom: 14rpx; }
.option-key { width: 42rpx; padding-top: 20rpx; color: #4b6ef5; font-weight: 600; }
.option-edit { flex: 1; min-width: 0; }
.image { display: block; width: 100%; margin-top: 16rpx; border-radius: 8rpx; }
.save { margin: 24rpx 0; border-radius: 999rpx; color: #fff; background: #4b6ef5; }
