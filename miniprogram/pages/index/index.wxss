.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 只有列表区域可伸缩滚动，其余区块禁止被压缩，
   否则内容过长时会被裁掉 */
.header,
.share-tip,
.cloud-error {
  flex-shrink: 0;
}

.header {
  padding: 32rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #4b6ef5, #6d8bff);
  color: #fff;
}

.header-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
}

.header-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.header-stat {
  text-align: right;
}

.header-stat-num {
  font-size: 48rpx;
  font-weight: 600;
}

.header-stat-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.header-share {
  margin-top: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 26rpx;
  text-align: center;
}

.share-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff7e6;
  color: #b54708;
  font-size: 26rpx;
}

.share-tip-text {
  flex: 1;
}

.share-tip-close {
  margin-left: 20rpx;
  font-size: 34rpx;
  line-height: 1;
  color: #d4a106;
}

.cloud-error {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fef3f2;
  border: 1rpx solid #fecdca;
}

.cloud-error-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.cloud-error-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #b42318;
}

.cloud-error-retry {
  font-size: 26rpx;
  color: #b42318;
  padding: 4rpx 16rpx;
  border: 1rpx solid #fda29b;
  border-radius: 24rpx;
}

.cloud-error-msg {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #912018;
  line-height: 1.6;
}

.cloud-error-help {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #4b6ef5;
}

.list {
  flex: 1;
  min-height: 0;
  margin-top: -20rpx;
  padding: 0 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 39, 51, 0.06);
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-progress {
  font-size: 26rpx;
  color: #8a93a5;
  margin-left: 20rpx;
}

.card-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a93a5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar {
  margin-top: 20rpx;
  height: 10rpx;
  background: #eef1f7;
  border-radius: 10rpx;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  background: #4b6ef5;
  border-radius: 10rpx;
  transition: width 0.3s;
}

.card-meta {
  margin-top: 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  background: #f1f3f8;
  color: #5a6474;
}

.tag-single {
  background: #e8efff;
  color: #4b6ef5;
}

.tag-public {
  background: #e9f7ef;
  color: #16b364;
}

.tag-shared {
  background: #f2e9ff;
  color: #7a4bd4;
}

.tag-multiple {
  background: #fff2e5;
  color: #f79009;
}

.tag-judge {
  background: #e9f7ef;
  color: #16b364;
}

.tag-wrong {
  background: #feeceb;
  color: #f04438;
}

.tag-star {
  background: #fff8e6;
  color: #d4a106;
}

.card-foot {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 24rpx;
  color: #a4abb8;
}

.empty {
  margin-top: 160rpx;
  text-align: center;
  padding: 0 40rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a93a5;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 40rpx;
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #b0b6c2;
  padding: 8rpx 0 32rpx;
}

.template-link {
  text-align: center;
  font-size: 26rpx;
  color: #4b6ef5;
  padding: 12rpx 0 32rpx;
}

.pad {
  height: 120rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: 50%;
  background: #4b6ef5;
  color: #fff;
  font-size: 56rpx;
  box-shadow: 0 10rpx 24rpx rgba(75, 110, 245, 0.4);
}
