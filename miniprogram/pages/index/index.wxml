<view class="page">
  <view class="header">
    <view class="header-top">
      <view>
        <view class="header-title">刷题助手</view>
        <view class="header-sub">题库 {{summary.banks}} 个 · 题目 {{summary.total}} 道</view>
      </view>
      <view class="header-stat">
        <view class="header-stat-num">{{summary.accuracy}}%</view>
        <view class="header-stat-label">总正确率</view>
      </view>
    </view>
    <button class="header-share" open-type="share">↗ 分享给好友</button>
  </view>

  <view wx:if="{{shareTip}}" class="share-tip">
    <text class="share-tip-text">{{shareTip}}</text>
    <text class="share-tip-close" bindtap="onCloseShareTip">×</text>
  </view>

  <view wx:if="{{cloudError}}" class="cloud-error">
    <view class="cloud-error-head">
      <text class="cloud-error-title">云开发连接失败</text>
      <text class="cloud-error-retry" bindtap="onRetry">重试</text>
    </view>
    <text class="cloud-error-msg">{{cloudError}}</text>
    <text class="cloud-error-help" bindtap="onShowCloudHelp">查看解决步骤 ›</text>
  </view>

  <view wx:if="{{preparing}}" class="preparing">
    <view class="preparing-head">
      <text class="preparing-title">正在准备高考化学题库</text>
      <text class="preparing-num" wx:if="{{preparing.total > 1}}">{{preparing.progress}}/{{preparing.total}} 卷</text>
    </view>
    <view class="bar"><view class="bar-inner" style="width: {{preparing.percent}}%"></view></view>
    <text class="preparing-desc">首次进入需要导入题目，导入期间可以正常使用其他功能</text>
  </view>

  <scroll-view scroll-y class="list" enable-flex>
    <view wx:if="{{banks.length === 0 && !cloudError}}" class="empty">
      <view class="empty-icon">📚</view>
      <view class="empty-title">还没有题库</view>
      <view class="empty-desc">支持导入 JSON 或文本格式的题目，导入后即可开始刷题</view>
      <button class="btn-primary empty-btn" bindtap="onImport">立即导入题库</button>
      <button class="btn-ghost empty-btn" bindtap="onOpenCatalog">添加高考化学题库</button>
    </view>

    <view
      wx:for="{{banks}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="onOpenBank"
      bindlongpress="onMoreAction"
    >
      <view class="card-head">
        <view class="card-name">{{item.name}}</view>
        <view class="card-progress">{{item.answered}}/{{item.count}}</view>
      </view>
      <view class="card-desc">{{item.desc || '暂无描述'}}</view>
      <view class="bar">
        <view class="bar-inner" style="width: {{item.percent}}%"></view>
      </view>
      <view class="card-meta">
        <text class="tag tag-default" wx:if="{{item.isDefault}}">默认题库</text>
        <text class="tag tag-public" wx:if="{{item.public}}">已公开</text>
        <text class="tag tag-shared" wx:if="{{!item.mine}}">好友共享</text>
        <text class="tag tag-single" wx:if="{{item.typeStat.single}}">单选 {{item.typeStat.single}}</text>
        <text class="tag tag-multiple" wx:if="{{item.typeStat.multiple}}">多选 {{item.typeStat.multiple}}</text>
        <text class="tag tag-judge" wx:if="{{item.typeStat.judge}}">判断 {{item.typeStat.judge}}</text>
        <text class="tag tag-subjective" wx:if="{{item.typeStat.subjective}}">主观 {{item.typeStat.subjective}}</text>
        <text class="tag tag-wrong" wx:if="{{item.wrong}}">错题 {{item.wrong}}</text>
        <text class="tag tag-star" wx:if="{{item.star}}">收藏 {{item.star}}</text>
      </view>
      <view class="card-foot">
        <text>正确率 {{item.accuracy}}%</text>
        <text>{{item.timeText}}</text>
      </view>
    </view>

    <view wx:if="{{banks.length}}" class="tip">长按题库卡片可重命名 / 清空记录 / 删除</view>
    <view wx:if="{{banks.length}}" class="template-link" bindtap="onOpenCatalog">＋ 添加高考化学题库（混合练习 / 地区试卷）</view>
    <view class="pad"></view>
  </scroll-view>

  <view class="fab" bindtap="onImport">＋</view>
</view>
